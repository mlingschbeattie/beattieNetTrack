---
import { getCollection } from 'astro:content';
import AppShell from '../layouts/AppShell.astro';
import ContinueLearning from '../components/islands/ContinueLearning.tsx';
import { getTrackDetailData } from '../lib/content';

const allTracks = await getCollection('tracks');

const TRACK_ORDER = [
  'tech-plus',
  'pc-technician',
  'network-engineer',
  'cybersecurity-foundations',
  'python-developer',
  'cybersecurity-engineer',
  'web-developer',
  'ai-ml',
  'linux',
  'cyber-literacy',
];

const visibleTracks = allTracks
  .filter((t) => !t.data.hidden)
  .sort((a, b) => {
    const ai = TRACK_ORDER.indexOf(a.slug);
    const bi = TRACK_ORDER.indexOf(b.slug);
    if (ai === -1 && bi === -1) return a.data.title.localeCompare(b.data.title);
    if (ai === -1) return 1;
    if (bi === -1) return -1;
    return ai - bi;
  });

const activityMap = Object.fromEntries(
  await Promise.all(
    visibleTracks.map(async (track) => {
      const detail = await getTrackDetailData(track.slug);
      const activities = detail
        ? detail.modules.flatMap((m) => m.activities.map(({ type, slug }) => ({ type, slug })))
        : [];
      return [track.slug, activities];
    })
  )
);

const tracksMeta = visibleTracks.map((t) => ({
  slug: t.slug,
  title: t.data.title,
  activityCount: activityMap[t.slug]?.length ?? 0,
}));

const isAvailable = (slug: string) => (activityMap[slug]?.length ?? 0) > 0;
---

<AppShell
  title="Beattie Tech • Tracks"
  tracks={visibleTracks}
  breadcrumbs={[{ label: 'Home' }]}
>
  <section class="hero">
    <h1 class="hero__title">Learning Dashboard</h1>
    <p class="hero__subtitle">Continue your path from dashboard to track to workspace.</p>
  </section>

  <!-- Section A: Continue Learning -->
  <section class="track-section">
    <div class="section-head">
      <h2>Continue Learning</h2>
      <div class="section-head-line"></div>
    </div>
    <ContinueLearning
      client:only="react"
      tracks={tracksMeta}
      activityMap={activityMap}
    />
  </section>

  <!-- Section B: Your Tracks -->
  <section class="track-section">
    <div class="section-head">
      <h2>Your Tracks</h2>
      <div class="section-head-line"></div>
    </div>
    <div class="card-grid card-grid--two">
      {visibleTracks.map((track) => (
        <article class="card card--track">
          <span class={`track-badge track-badge--${isAvailable(track.slug) ? 'available' : 'coming-soon'}`}>
            {isAvailable(track.slug) ? 'Available' : 'Coming Soon'}
          </span>
          <h3>{track.data.icon ? `${track.data.icon} ` : ''}{track.data.title}</h3>
          <p>{track.data.description}</p>
          <div class="card__meta">
            <span class="badge">{activityMap[track.slug]?.length ?? 0} activities</span>
            {track.data.estimatedHours && (
              <span class="badge badge--muted">~{track.data.estimatedHours} hrs</span>
            )}
          </div>
          <div class="card__footer">
            <a class="btn-link" href={`/tracks/${track.slug}`}>Open track →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Section C: Quick Actions -->
  <section class="track-section">
    <div class="section-head">
      <h2>Quick Actions</h2>
      <div class="section-head-line"></div>
    </div>
    <div class="quick-actions">
      <a class="quick-action" href="/tracks">Browse All Tracks →</a>
      <a class="quick-action" href="/quizzes">Open Study Hub →</a>
      <a class="quick-action" href="/labs">Take a Lab →</a>
    </div>
  </section>
</AppShell>
