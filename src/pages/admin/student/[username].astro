---
import AppShell from '../../../layouts/AppShell.astro';
import { getCollection } from 'astro:content';
import StudentProfile from '../../../components/teacher/StudentProfile';

const { username } = Astro.params as { username: string };
const tracks = await getCollection('tracks');
const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://api.beattietech.local';

---

<AppShell
  title={`${username} — Student Profile`}
  tracks={tracks}
  breadcrumbs={[
    { label: 'Admin', href: '/admin' },
    { label: username },
  ]}
>
  <div class="student-detail-page">
    <header class="student-detail-page__header">
      <a href="/admin" class="student-detail-page__back">← Back to Roster</a>
      <h1>{username}</h1>
    </header>

    <StudentProfile username={username} apiUrl={apiUrl} isTeacher={true} client:load />
  </div>
</AppShell>

<style>
  .student-detail-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .student-detail-page__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .student-detail-page__back {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .student-detail-page__back:hover {
    color: var(--color-text);
  }

  .student-detail-page__header h1 {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin: 0;
  }

  .student-detail-page__section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .student-detail-page__section h2 {
    font-size: var(--text-xl);
    font-weight: 600;
    margin: 0;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-3);
  }

  .student-detail-page__section-sub {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin: 0;
  }

  /* StudentProfile component styles */
  :global(.student-profile) {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  :global(.student-profile__loading) {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  :global(.student-profile__header) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  :global(.student-profile__name) {
    font-size: var(--text-xl);
    font-weight: 700;
    margin: 0 0 var(--space-1);
  }

  :global(.student-profile__meta) {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  :global(.student-profile__exam-badge) {
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  :global(.student-profile__cert) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  :global(.student-profile__cert-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  :global(.student-profile__cert-name) {
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0;
  }

  :global(.student-profile__domains) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  :global(.student-profile__domains th) {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--color-border);
  }

  :global(.student-profile__domains td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  :global(.student-profile__domain-code) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  :global(.mastery-bar) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 120px;
  }

  :global(.mastery-bar__track) {
    flex: 1;
    height: 8px;
    background: var(--color-border);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  :global(.mastery-bar__fill) {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width 0.4s ease;
  }

  :global(.mastery-bar__pct) {
    font-size: var(--text-xs);
    font-weight: 700;
    min-width: 34px;
    text-align: right;
  }

  /* Override modal */
  :global(.override-modal-backdrop) {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }

  :global(.override-modal) {
    background: var(--color-surface-2, #18213b);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  :global(.override-modal h3) {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0;
  }

  :global(.override-modal__meta) {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    font-family: var(--font-mono);
  }

  :global(.override-modal__label) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  :global(.override-modal__error) {
    color: #E24B4A;
    font-size: var(--text-sm);
    margin: 0;
  }

  :global(.override-modal__actions) {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
  }

  /* Industry Certifications & Prior Learning Section */
  :global(.student-profile__certs-section) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  :global(.student-profile__certs-header) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  :global(.student-profile__section-title) {
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0 0 var(--space-1);
    color: var(--color-text);
  }

  :global(.student-profile__section-desc) {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
    max-width: 650px;
    line-height: 1.4;
  }

  :global(.student-profile__no-certs) {
    padding: var(--space-4);
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  :global(.student-profile__cert-badges-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-4);
  }

  :global(.student-cert-badge-card) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: rgba(16, 185, 129, 0.04);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: var(--radius-md);
  }

  :global(.student-cert-badge-card__top) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2);
  }

  :global(.student-cert-badge-card__badge) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  :global(.student-cert-badge-card__icon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
    font-size: var(--text-xs);
    font-weight: 700;
    flex-shrink: 0;
  }

  :global(.student-cert-badge-card__title) {
    font-size: var(--text-sm);
    font-weight: 600;
    margin: 0;
    color: var(--color-text);
  }

  :global(.student-cert-badge-card__code) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: #10b981;
    font-weight: 500;
  }

  :global(.student-cert-badge-card__revoke) {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding: 2px 6px;
    cursor: pointer;
  }

  :global(.student-cert-badge-card__revoke:hover) {
    color: #ef4444;
  }

  :global(.student-cert-badge-card__details) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--text-xs);
    padding-left: 30px;
  }

  :global(.student-cert-badge-card__meta-item) {
    display: flex;
    gap: var(--space-2);
  }

  :global(.student-cert-badge-card__meta-item .label) {
    color: var(--color-text-muted);
  }

  :global(.student-cert-badge-card__meta-item .val) {
    color: var(--color-text);
  }

  :global(.student-cert-badge-card__crossovers) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px dashed rgba(16, 185, 129, 0.2);
  }

  :global(.student-cert-badge-card__crossover-label) {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  :global(.student-cert-badge-card__crossover-chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  :global(.student-cert-badge-card__chip) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
    color: #6ee7b7;
  }

  :global(.student-cert-badge-card__chip code) {
    font-family: var(--font-mono);
    color: #a7f3d0;
  }

  /* Record Cert Modal Extras */
  :global(.record-cert-modal) {
    max-width: 540px;
  }

  :global(.record-cert-modal__row) {
    display: flex;
    gap: var(--space-3);
  }

  :global(.crossover-preview-box) {
    padding: var(--space-3);
    background: var(--color-surface, #0f172a);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  :global(.crossover-preview-box__title) {
    font-size: var(--text-xs);
    font-weight: 600;
    color: #38bdf8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.crossover-preview-box__desc) {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.4;
  }

  :global(.crossover-preview-box__list) {
    margin: var(--space-1) 0 0;
    padding-left: var(--space-4);
    font-size: 11px;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  :global(.crossover-preview-box__list code) {
    font-family: var(--font-mono);
    color: #6ee7b7;
  }
</style>
