---
import { getCollection } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';
import TourProgressCard from '../../components/islands/TourProgressCard.tsx';

const tracks = await getCollection('tracks');
const steps = (await getCollection('tour')).sort((a, b) => a.data.order - b.data.order);
const first = steps[0];
---

<AppShell title="Hands-On Tour" tracks={tracks} breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Tour' }]}> 
  <section class="hero">
    <h1 class="hero__title">Try It Tour</h1>
    <p class="hero__subtitle">Experience a mini version of the program with terminal, quiz, and code challenges.</p>
  </section>

  <section class="card-grid card-grid--two">
    <article class="card">
      <h2>Tour Chapters</h2>
      <p style="color: var(--text-muted); margin-bottom: var(--space-4); font-size: var(--text-sm);">Complete each challenge in order. Estimated time: ~5 minutes.</p>
      <ol class="tour-chapter-list">
        {steps.map((step, i) => (
          <li class="tour-chapter-item">
            <a href={`/tour/${step.slug}`} class="tour-chapter-link">
              <span class="tour-chapter-num">{i + 1}</span>
              <span class="tour-chapter-info">
                <strong>{step.data.title}</strong>
                {step.data.description && <span class="tour-chapter-desc">{step.data.description}</span>}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </article>

    {first && <TourProgressCard client:load tourSlug="hands-on-tour" firstStepSlug={first.slug} />}
  </section>
</AppShell>
