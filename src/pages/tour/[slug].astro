---
import { getCollection } from 'astro:content';
import WorkspaceLayout from '../../layouts/WorkspaceLayout.astro';
import InstructionSteps from '../../components/workspace/InstructionSteps.astro';
import TerminalSimulator from '../../components/islands/TerminalSimulator.tsx';
import QuizRunner from '../../components/QuizRunner.tsx';
import CodeRunner from '../../components/islands/CodeRunner.tsx';
import ActivityCard from '../../components/ActivityCard.astro';
import type { QuizDefinition } from '../../lib/quizEngine';

export async function getStaticPaths() {
  const steps = await getCollection('tour');
  return steps.map((step) => ({ params: { slug: step.slug }, props: { step } }));
}

const { step } = Astro.props;
const tracks = await getCollection('tracks');
const allTour = (await getCollection('tour')).sort((a, b) => a.data.order - b.data.order);
const quizzes = await getCollection('quizzes');
const { Content } = await step.render();

const totalSteps = allTour.length;
const quizEntry = step.data.quizSlug ? quizzes.find((entry) => entry.slug === step.data.quizSlug) : undefined;
const quizDefinition: QuizDefinition | undefined = quizEntry
  ? {
      slug: quizEntry.slug,
      title: quizEntry.data.title,
      description: quizEntry.data.description,
      passThreshold: quizEntry.data.passThreshold,
      questions: quizEntry.data.questions,
    }
  : undefined;
---

<WorkspaceLayout
  title={`Tour • ${step.data.title}`}
  tracks={tracks}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Tour', href: '/tour' },
    { label: step.data.title },
  ]}
  itemSlug={step.slug}
  itemType="tour"
  itemDifficulty="Beginner"
  itemMinutes={10}
  checkLabel="Check"
  submitLabel="Submit"
  activityTabs={[
    { id: 'activity', label: 'Try It' },
    { id: 'secondary', label: 'Notes' },
  ]}
>
  <Fragment slot="instructions">
    <h1 class="page-title">{step.data.title}</h1>
    <p class="lesson-header__description">{step.data.description}</p>
    <Content />
    <InstructionSteps
      storageKey={`steps:tour:${step.slug}`}
      steps={[
        'Complete the interactive task on the right',
        'Use Check or Submit to validate your work',
      ]}
    />
    {step.data.next && (
      <p style="margin-top: var(--space-4);">
        <a class="btn-link" href={`/tour/${step.data.next}`} data-testid="tour-next-link">{step.data.ctaLabel ?? 'Continue'} →</a>
      </p>
    )}
    {!step.data.next && (
      <p style="margin-top: var(--space-4);">
        <a class="btn-link" href="/tracks/cybersecurity-foundations">Explore Tracks →</a>
      </p>
    )}
  </Fragment>

  <Fragment slot="activity-main">
    {step.data.kind === 'terminal' && (
      <TerminalSimulator
        client:load
        labSlug={step.slug}
        scenarioSlug={step.data.terminalScenario ?? 'tour-terminal-challenge'}
      />
    )}

    {step.data.kind === 'quiz' && quizDefinition && (
      <QuizRunner client:only="react" quiz={quizDefinition} workspaceSlug={step.slug} />
    )}

    {step.data.kind === 'code' && (
      <CodeRunner client:only="react" labSlug={step.slug} exerciseSlug={step.data.codeExercise ?? 'tour-code-challenge'} />
    )}

    {(step.data.kind === 'intro' || step.data.kind === 'complete') && (
      <ActivityCard>
        <h3>{step.data.kind === 'intro' ? 'Tour overview' : 'Nice work!'}</h3>
        <p>{step.data.kind === 'intro' ? 'Use the next button to start your first challenge.' : 'You finished all tour challenges.'}</p>
      </ActivityCard>
    )}
  </Fragment>

  <Fragment slot="activity-secondary">
    <ActivityCard>
      <h3>Tour Notes</h3>
      <p>These steps mirror the same workspace pattern used in full tracks.</p>
      <p data-testid="tour-step-meta">Step {step.data.order} of {totalSteps}</p>
    </ActivityCard>
  </Fragment>
</WorkspaceLayout>
