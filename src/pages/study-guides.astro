---
import { getCollection } from 'astro:content';
import AppShell from '../layouts/AppShell.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Study Guides' },
];

const guides = (await getCollection('studyGuides'))
  .filter((guide) => !guide.data.isDraft)
  .sort((a, b) => a.data.order - b.data.order);

const groupedGuides = Array.from(
  guides.reduce((groups, guide) => {
    const track = guide.data.track;
    if (!groups.has(track)) {
      groups.set(track, [] as typeof guides);
    }
    groups.get(track)?.push(guide);
    return groups;
  }, new Map<string, typeof guides>())
);

const formatHours = (hours: number | string) => {
  if (typeof hours === 'string') return `${hours} hours`;
  return `${hours} hours`;
};
---

<AppShell title="Study Guides" breadcrumbs={breadcrumbs}>
  <section class="hero">
    <h1 class="hero__title">Study Guides</h1>
    <p class="hero__subtitle">Structured guides with quizzes and labs to prepare for certification.</p>
  </section>

  {groupedGuides.map(([track, trackGuides]) => (
    <section class="track-section">
      <h2 class="track-section__title">{track}</h2>
      <div class="card-grid card-grid--three">
        {trackGuides.map((guide) => (
          <article class="card card--glass">
            <a href={`/study-guides/${guide.slug}`} style="display:block;color:inherit;text-decoration:none;">
              <h3>{guide.data.title}</h3>
              <p>{guide.data.description}</p>
              <div class="card__meta">
                <span class="pill">{guide.data.quizzes} quizzes</span>
                <span class="pill">{formatHours(guide.data.hours)}</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  ))}
</AppShell>
