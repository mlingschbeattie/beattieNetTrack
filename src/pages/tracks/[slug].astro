---
import { getCollection } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';
import TrackProgressSummary from '../../components/islands/TrackProgressSummary.tsx';
import TrackModuleList from '../../components/islands/TrackModuleList.tsx';
import { getTrackDetailData, getTracksIndexData } from '../../lib/content';

export async function getStaticPaths() {
  const tracks = await getTracksIndexData();
  return tracks
    .filter((track) => track.slug !== 'legacy')
    .map((track) => ({ params: { slug: track.slug } }));
}

const slug = Astro.params.slug ?? '';
const [allTracks, allLessons, detail] = await Promise.all([
  getCollection('tracks'),
  getCollection('lessons'),
  getTrackDetailData(slug),
]);

if (!detail) {
  return Astro.redirect('/tracks');
}

const lessonMap = Object.fromEntries(allLessons.map((entry) => [entry.slug, entry]));
const track = detail.track;
const modules = detail.modules;

// prevNextByKey powers server-side activity navigation and is never read by
// TrackModuleList, but it serialises into the island props — duplicating every
// activity as both a prev and a next object. On network-engineer that was the
// bulk of a 114 KB props blob. Strip it before it crosses to the client.
const modulesForList = modules.map(({ prevNextByKey, ...rest }) => rest);
const currentTrack = allTracks.find((entry) => entry.slug === slug);

const hasModules = Boolean(modules && modules.length > 0);
const activities = hasModules
  ? modules.flatMap((m) => m.activities.map((act) => ({ slug: act.slug, type: act.type })))
  : currentTrack?.data.sections?.flatMap((section) =>
      (section.lessons ?? [])
        .map((item) => (typeof item === 'string' ? { type: 'lesson' as const, slug: item } : item))
        .map((item) => ({ slug: item.slug, type: item.type }))
    ) ?? [];
const activitySlugs = activities.map((act) => act.slug);
---

<AppShell
  title={`Track • ${track.title}`}
  tracks={allTracks}
  activeTrack={track.slug}
  currentTrack={currentTrack}
  lessonMap={lessonMap}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Learning Tracks', href: '/tracks' },
    { label: track.title },
  ]}
>
  <section class="hero">
    <h1 class="hero__title">{track.title}</h1>
    <p class="hero__subtitle">{track.description}</p>
  </section>

  <div class="track-progress__wrap">
    <TrackProgressSummary client:only="react" activities={activities} activitySlugs={activitySlugs} />
  </div>

  <TrackModuleList client:load modules={modulesForList} />
</AppShell>
