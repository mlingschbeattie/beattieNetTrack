---
import { getCollection } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';
import TrackProgressSummary from '../../components/islands/TrackProgressSummary.tsx';
import { getTrackDetailData, getTracksIndexData } from '../../lib/content';
import { getTrackSectionLessonSlugs } from '../../lib/trackSections';

export async function getStaticPaths() {
  const tracks = await getTracksIndexData();
  return tracks
    .filter((track) => track.slug !== 'legacy')
    .map((track) => ({ params: { slug: track.slug } }));
}

const slug = Astro.params.slug ?? '';
const [allTracks, allLessons, detail] = await Promise.all([
  getCollection('tracks'),
  getCollection('lessons'),
  getTrackDetailData(slug),
]);

if (!detail) {
  return Astro.redirect('/tracks');
}

const lessonMap = Object.fromEntries(allLessons.map((entry) => [entry.slug, entry]));
const track = detail.track;
const modules = detail.modules;
const currentTrack = allTracks.find((entry) => entry.slug === slug);
const lessonSlugs = currentTrack ? getTrackSectionLessonSlugs(currentTrack) : [];
---

<AppShell
  title={`Track • ${track.title}`}
  tracks={allTracks}
  activeTrack={track.slug}
  currentTrack={currentTrack}
  lessonMap={lessonMap}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Learning Tracks', href: '/tracks' },
    { label: track.title },
  ]}
>
  <section class="hero">
    <h1 class="hero__title">{track.title}</h1>
    <p class="hero__subtitle">{track.description}</p>
  </section>

  <div class="track-progress__wrap">
    <TrackProgressSummary client:only="react" lessonSlugs={lessonSlugs} />
  </div>

  {modules.length > 0 ? (
    modules.map((module) => (
      <section class="track-section">
        <h2 class="track-section__title">{module.title}</h2>
        {module.description && <p class="track-section__subtitle">{module.description}</p>}
        <div class="card-grid">
          {module.activities.map((activity) => (
            <article class="card card--lesson">
              <h3>{activity.title}</h3>
              <p>{activity.description}</p>
              <div class="card__meta">
                <span class="badge">{activity.type === 'lab' ? 'Lab' : activity.type === 'quiz' ? 'Quiz' : 'Lesson'}</span>
              </div>
              <div class="card__footer">
                <a class="btn-link" href={activity.href}>Open activity →</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  ) : (
    <section class="track-section">
      <h2 class="track-section__title">Modules</h2>
      <article class="card">
        <h3>No modules published yet</h3>
        <p>This track is configured, but no module activities are available right now.</p>
      </article>
    </section>
  )}
</AppShell>
