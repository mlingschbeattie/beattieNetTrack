---
import { getCollection } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';
import { getTracksIndexData, getTrackDetailData } from '../../lib/content';

const [trackCards, allTracks] = await Promise.all([getTracksIndexData(), getCollection('tracks')]);
const tracks = allTracks.filter((t) => !t.data.hidden);

const activityCounts = Object.fromEntries(
  await Promise.all(
    trackCards.map(async (t) => {
      const detail = await getTrackDetailData(t.slug);
      const count = detail ? detail.modules.reduce((s, m) => s + m.activities.length, 0) : 0;
      return [t.slug, count];
    })
  )
);
---

<AppShell
  title="Learning Tracks"
  tracks={tracks}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Learning Tracks' },
  ]}
>
  <section class="hero">
    <h1 class="hero__title">Learning Tracks</h1>
    <p class="hero__subtitle">Choose a track to view modules and activities.</p>
  </section>

  <section class="card-grid">
    {trackCards.map((track) => (
      <article class="card card--track">
        <span class={`track-badge track-badge--${activityCounts[track.slug] > 0 ? 'available' : 'coming-soon'}`}>
          {activityCounts[track.slug] > 0 ? 'Available' : 'Coming Soon'}
        </span>
        <h3>{track.title}</h3>
        <p>{track.description}</p>
        <div class="card__meta">
          <span class="badge">{activityCounts[track.slug] ?? 0} activities</span>
        </div>
        <div class="card__footer">
          <a class="btn-link" href={`/tracks/${track.slug}`}>Open track →</a>
        </div>
      </article>
    ))}
  </section>
</AppShell>
