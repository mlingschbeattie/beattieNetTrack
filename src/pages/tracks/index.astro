---
import { getCollection } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';
import { getTracksIndexData } from '../../lib/content';

const [trackCards, tracks] = await Promise.all([getTracksIndexData(), getCollection('tracks')]);
---

<AppShell
  title="Learning Tracks"
  tracks={tracks}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Learning Tracks' },
  ]}
>
  <section class="hero">
    <h1 class="hero__title">Learning Tracks</h1>
    <p class="hero__subtitle">Choose a track to view modules and activities.</p>
  </section>

  <section class="card-grid">
    {trackCards.map((track) => (
      <article class="card">
        <h3>{track.title}</h3>
        <p>{track.description}</p>
        <div class="card__meta">
          <span class="badge">Track</span>
        </div>
        <div class="card__footer">
          <a class="btn-link" href={`/tracks/${track.slug}`}>Open track →</a>
        </div>
      </article>
    ))}
  </section>
</AppShell>
