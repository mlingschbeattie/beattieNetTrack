---
import { getCollection } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';
import LessonHeader from '../../components/LessonHeader.astro';
import Callout from '../../components/Callout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import OutlineView from '../../components/islands/OutlineView.tsx';
import GuidedView from '../../components/islands/GuidedView.tsx';
import ReadingProgressRail from '../../components/islands/ReadingProgressRail.tsx';
import { normalizeLessonMeta } from '../../lib/lessonMeta';
import { getActivityModuleNavigation } from '../../lib/content';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({ params: { slug: lesson.slug }, props: { lesson } }));
}

const allTracks = await getCollection('tracks');
const allLessons = await getCollection('lessons');
const paramSlug = Astro.params.slug;
const lesson = Astro.props.lesson ?? allLessons.find((entry) => entry.slug === paramSlug);

if (!lesson) {
  return Astro.redirect('/tracks');
}

const { Content } = await lesson.render();
const meta = normalizeLessonMeta(lesson.data);
const activityNavigation = await getActivityModuleNavigation({ type: 'lesson', slug: lesson.slug });

const url = new URL(Astro.request.url);
const trackParam = url.searchParams.get('track');

const lessonMap = Object.fromEntries(allLessons.map((entry) => [entry.slug, entry]));
const trackFromParam = allTracks.find((entry) => entry.slug === trackParam);
const trackFromFrontmatter = lesson.data.track
  ? allTracks.find((entry) => entry.slug === lesson.data.track)
  : null;
const trackFromActivityNavigation = activityNavigation
  ? allTracks.find((entry) => entry.slug === activityNavigation.trackSlug)
  : null;

const currentTrack = trackFromParam ?? trackFromFrontmatter ?? trackFromActivityNavigation ?? null;
// Enable legacy skin only for the single page '/lessons/cryptography' for visual testing.
const enableLegacy = lesson.slug === 'cryptography';

const authoredSections = lesson.data.sections ?? [];
const outlineSections = authoredSections.length
  ? authoredSections
  : [
      {
        id: 'lesson-overview',
        title: 'Lesson Overview',
        keyPoints: [
          `Main topic: ${lesson.data.title}`,
          'Use Reading view for full lesson details and examples.',
          'Use this quick check to confirm understanding before moving on.',
        ],
        check: [
          {
            prompt: `This lesson is titled "${lesson.data.title}".`,
            options: ['True', 'False', 'Only in labs', 'Only in quizzes'],
            correct: 0,
          },
          {
            prompt: 'Which view contains the full lesson text and walkthrough?',
            options: ['Outline view', 'Reading view', 'Track sidebar', 'Module badge'],
            correct: 1,
          },
        ],
      },
    ];
---

<AppShell
  legacySkin={enableLegacy}
  title={`Lesson • ${lesson.data.title}`}
  tracks={allTracks}

  <section class="lesson-body lesson-body--reading" data-view-pane="reading" hidden>
    <div class="lesson-reading-layout">
      <div class="lesson-reading-main" data-reading-content>
        <Content components={{ Callout, CodeBlock }} />
      </div>
      <aside class="lesson-reading-rail">
        <ReadingProgressRail client:only="react" lessonSlug={lesson.slug} sections={outlineSections} />
      </aside>
    </div>
  </section>

  <script is:inline>
      (() => {
        const root = document.querySelector('[data-lesson-toggle]');
        if (!root) return;
        const buttons = root.querySelectorAll('.lvt-btn');
        const panes = document.querySelectorAll('[data-view-pane]');
        const completedEl = root.querySelector('[data-outline-completed]');
        const totalEl = root.querySelector('[data-outline-total]');

        const wrapReadingTables = () => {
          const readingRoot = document.querySelector('[data-reading-content]');
          if (!readingRoot) return;
          const tables = Array.from(readingRoot.querySelectorAll('table'));
          tables.forEach((table) => {
            if (table.parentElement?.classList.contains('lesson-table-wrap')) return;
            const wrapper = document.createElement('div');
            wrapper.className = 'lesson-table-wrap';
            table.parentNode?.insertBefore(wrapper, table);
            wrapper.appendChild(table);

            const headerRow = table.querySelector('thead tr') ?? table.querySelector('tr');
            if (!(headerRow instanceof HTMLTableRowElement)) return;

            const labels = Array.from(headerRow.querySelectorAll('th, td'))
              .map((cell) => cell.textContent?.trim() || '')
              .filter(Boolean);
            if (!labels.length) return;

            table.classList.add('lesson-table--stack');
            const rows = Array.from(table.querySelectorAll('tbody tr'));
            rows.forEach((row) => {
              const cells = Array.from(row.querySelectorAll('th, td'));
              cells.forEach((cell, index) => {
                if (!(cell instanceof HTMLElement)) return;
                if (cell.dataset.label) return;
                cell.dataset.label = labels[index] ?? `Column ${index + 1}`;
              });
            });
          });
        };

        wrapReadingTables();

        const setView = (view) => {
          buttons.forEach((btn) => {
            const active = btn.getAttribute('data-view') === view;
            btn.classList.toggle('is-active', active);
            btn.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          panes.forEach((pane) => {
            const match = pane.getAttribute('data-view-pane') === view;
            if (match) {
              pane.removeAttribute('hidden');
            } else {
              pane.setAttribute('hidden', '');
            }
          });
          if (view === 'reading') {
            wrapReadingTables();
          }
        };

        buttons.forEach((btn) => {
          btn.addEventListener('click', () => setView(btn.getAttribute('data-view')));
        });

        window.addEventListener('lesson:jump-reading', (event) => {
          const detail = event.detail;
          if (!detail || typeof detail.title !== 'string') return;
          setView('reading');
          wrapReadingTables();
          const headings = Array.from(document.querySelectorAll('[data-reading-content] h2'));
          const target = headings.find((heading) => heading.textContent?.trim() === detail.title);
          if (target instanceof HTMLElement) {
            if (!target.id) {
              target.id = `lesson-heading-${Math.random().toString(36).slice(2, 8)}`;
            }
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });

        window.addEventListener('outline-progress', (event) => {
          const detail = event.detail;
          if (!detail || !completedEl) return;
          completedEl.textContent = String(detail.completed);
          if (totalEl && Number.isFinite(detail.total)) {
            totalEl.textContent = String(detail.total);
          }
        });
      })();
    </script>

  <style>
      .lesson-view-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        margin: var(--space-6) 0 var(--space-4);
        padding: var(--space-2);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        flex-wrap: wrap;
      }
      .lesson-view-toggle__buttons {
        display: inline-flex;
        gap: var(--space-1);
      }
      .lvt-btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-4);
        background: transparent;
        color: var(--color-text-muted);
        border: 1px solid transparent;
        border-radius: var(--radius-sm);
        font: inherit;
        font-weight: 600;
        cursor: pointer;
        transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
      }
      .lvt-btn:hover {
        color: var(--color-text);
        background: var(--color-surface-2);
      }
      .lvt-btn.is-active {
        color: var(--color-primary);
        background: var(--color-highlight);
        border-color: var(--color-primary);
      }
      .lesson-view-toggle__progress {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
        padding-right: var(--space-3);
      }
      .lesson-outline {
        margin-top: var(--space-4);
      }
      .lesson-guided {
        margin-top: var(--space-4);
      }
      .lesson-reading-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
        gap: var(--space-5);
        align-items: start;
      }
      .lesson-reading-main {
        min-width: 0;
      }
      .lesson-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        margin: var(--space-4) 0;
      }
      .lesson-reading-main table {
        border-collapse: collapse;
        width: max-content;
        min-width: 100%;
        margin: 0;
      }
      .lesson-reading-main th,
      .lesson-reading-main td {
        white-space: normal;
        overflow-wrap: normal;
        word-break: normal;
        hyphens: none;
        vertical-align: top;
      }
      .lesson-reading-main table th:first-child,
      .lesson-reading-main table td:first-child {
        white-space: nowrap;
      }
      .lesson-reading-rail {
        min-width: 0;
      }
      @media (max-width: 768px) {
        .lesson-reading-main table.lesson-table--stack {
          display: block;
          width: 100%;
          min-width: 0;
        }
        .lesson-reading-main table.lesson-table--stack thead {
          position: absolute;
          width: 1px;
          height: 1px;
          margin: -1px;
          padding: 0;
          border: 0;
          overflow: hidden;
          clip: rect(0 0 0 0);
        }
        .lesson-reading-main table.lesson-table--stack tbody,
        .lesson-reading-main table.lesson-table--stack tr,
        .lesson-reading-main table.lesson-table--stack th,
        .lesson-reading-main table.lesson-table--stack td {
          display: block;
          width: 100%;
        }
        .lesson-reading-main table.lesson-table--stack tr {
          margin: 0 0 var(--space-3);
          padding: var(--space-2);
          border: 1px solid var(--border-subtle);
          border-radius: var(--radius-sm);
          background: var(--color-surface);
        }
        .lesson-reading-main table.lesson-table--stack th,
        .lesson-reading-main table.lesson-table--stack td {
          border: 0;
          white-space: normal;
          padding: var(--space-2) var(--space-2);
          display: grid;
          grid-template-columns: minmax(7.5rem, 40%) 1fr;
          gap: var(--space-2);
          align-items: start;
        }
        .lesson-reading-main table.lesson-table--stack th::before,
        .lesson-reading-main table.lesson-table--stack td::before {
          content: attr(data-label) ':';
          font-weight: 700;
          color: var(--color-text);
          text-transform: uppercase;
          font-size: var(--text-xs);
          letter-spacing: 0.03em;
        }
        .lesson-reading-main table.lesson-table--stack tbody tr:last-child {
          margin-bottom: 0;
        }
      }
      @media (max-width: 1100px) {
        .lesson-reading-layout {
          grid-template-columns: 1fr;
        }
        .lesson-reading-rail {
          order: -1;
        }
      }
  </style>
</AppShell>
