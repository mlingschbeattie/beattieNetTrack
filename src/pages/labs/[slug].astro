---
import { getCollection } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';
import WorkspaceLayout from '../../layouts/WorkspaceLayout.astro';
import Card from '../../components/Card.astro';
import Section from '../../components/Section.astro';
import LabFrame from '../../components/LabFrame.astro';
import Callout from '../../components/Callout.astro';
import PcAssemblyLab from '../../components/labs/PcAssemblyLab.tsx';
import ActivityCard from '../../components/ActivityCard.astro';
import LabRunner from '../../components/LabRunner.tsx';
import CodeRunner from '../../components/islands/CodeRunner.tsx';
import BeaconEmitter from '../../components/BeaconEmitter.tsx';
import { getActivityModuleNavigation } from '../../lib/content';

export async function getStaticPaths() {
  const labs = await getCollection('labs');
  return labs
    .filter((lab) => !lab.data.hidden && lab.slug !== 'code-basics')
    .map((lab) => ({ params: { slug: lab.slug }, props: { lab } }));
}

// With `output: 'server'` getStaticPaths does not run, so Astro.props is empty
// and the entry has to be looked up from the route param. Same pattern as
// lessons/[slug].astro and quizzes/[slug].astro.
// The fallback must apply the SAME exclusions as getStaticPaths, or hidden
// labs (and code-basics, which is reached through its own route) become
// reachable here that the static path list deliberately omits.
const allLabs = await getCollection('labs');
const paramSlug = Astro.params.slug;
const lab =
  Astro.props.lab ??
  allLabs.find(
    (entry) => entry.slug === paramSlug && !entry.data.hidden && entry.slug !== 'code-basics'
  );

if (!lab) {
  return Astro.redirect('/tracks');
}

const tracks = await getCollection('tracks');
const { Content } = await lab.render();
const currentTrack = lab.data.track ? tracks.find((track) => track.slug === lab.data.track) : undefined;
const activityNavigation = await getActivityModuleNavigation({ type: 'lab', slug: lab.slug });
const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://api.beattietech.local';

type LabStep = {
  id: string;
  title: string;
  prompt: string;
  inputLabel?: string;
  placeholder?: string;
  hint?: string;
  validator:
    | { type: 'exact'; value: string }
    | { type: 'oneOf'; values: string[] }
    | { type: 'regex'; pattern: string; flags?: string }
    | { type: 'choice'; options: string[]; correctIndex: number; rationale?: string };
  successMessage?: string;
};

const terminalBasicsFallbackSteps: LabStep[] = [
  {
    id: 'pwd',
    title: 'Where am I?',
    prompt: 'Run the command that prints the current working directory.',
    hint: "It stands for 'print working directory'.",
    validator: { type: 'exact', value: 'pwd' },
  },
  {
    id: 'ls',
    title: 'List files',
    prompt: 'Run the command that lists files in the current directory.',
    hint: 'Try the short version, then the long listing.',
    validator: { type: 'oneOf', values: ['ls', 'ls -la', 'ls -l', 'dir'] },
  },
  {
    id: 'cd-up',
    title: 'Move up a directory',
    prompt: 'Change directory to the parent folder.',
    hint: 'Use cd with two dots.',
    validator: { type: 'oneOf', values: ['cd ..', 'cd..'] },
  },
];

const resolvedSteps: LabStep[] =
  Array.isArray(lab.data.steps) && lab.data.steps.length > 0
    ? (lab.data.steps as LabStep[])
    : lab.slug === 'terminal-basics'
      ? terminalBasicsFallbackSteps
      : [];

const isStepLab = resolvedSteps.length > 0;
const estimatedMinutes = lab.data.estimatedMinutes ?? lab.data.estMinutes ?? 20;
const xpReward = typeof lab.data.xp === 'number' ? lab.data.xp : 25;

const breadcrumbs: Array<{ label: string; href?: string }> = [
  { label: 'Home', href: '/' },
  { label: 'Labs', href: '/labs' },
  { label: `Lab: ${lab.data.title}` },
];

if (currentTrack) {
  breadcrumbs.splice(2, 0, { label: currentTrack.data.title, href: `/tracks/${currentTrack.slug}` });
}
---

{isStepLab ? (
  <AppShell
    title={`Lab • ${lab.data.title}`}
    tracks={tracks}
    activeTrack={currentTrack?.slug}
    activeLesson={lab.slug}
    currentTrack={currentTrack}
    breadcrumbs={breadcrumbs}
    activityNavigation={activityNavigation}
  >
    <section class="hero">
      <h1 class="hero__title">{lab.data.title}</h1>
      <p class="hero__subtitle">{lab.data.description}</p>
      <div class="card__meta">
        <span class="badge">{lab.data.difficulty}</span>
        <span class="badge badge--muted">⏱️ {estimatedMinutes} min</span>
        <span class="badge badge--muted">⭐ {xpReward} XP</span>
      </div>
    </section>

    <Section title="Interactive Lab">
      <Card>
        <LabRunner
          client:only="react"
          labSlug={lab.slug}
          title={lab.data.title}
          steps={resolvedSteps}
          xpReward={xpReward}
          backToTrackHref={currentTrack ? `/tracks/${currentTrack.slug}` : '/tracks/network-engineer'}
          domains={lab.data.domains ?? []}
          apiUrl={apiUrl}
        />
      </Card>
    </Section>

    <Section title="Overview">
      <article class="lesson-body card">
        <Content components={{ Callout }} />
      </article>
    </Section>
  </AppShell>
) : (
  <WorkspaceLayout
    title={`Lab • ${lab.data.title}`}
    tracks={tracks}
    activeTrack={currentTrack?.slug}
    activeLesson={lab.slug}
    currentTrack={currentTrack}
    breadcrumbs={breadcrumbs}
    itemSlug={lab.slug}
    itemType="lab"
    itemDifficulty={lab.data.difficulty}
    itemMinutes={estimatedMinutes}
    checkLabel={lab.data.checkLabel}
    submitLabel={lab.data.submitLabel}
    panelHints={lab.data.hints}
    panelChecklist={lab.data.checklist}
    activityNavigation={activityNavigation}
    activityTabs={[
      { id: 'activity', label: 'Lab' },
      { id: 'secondary', label: 'Notes' },
    ]}
  >
    <Fragment slot="instructions">
      <h1 class="page-title">{lab.data.title}</h1>
      <p class="lesson-header__description">{lab.data.description}</p>
      <Content components={{ Callout }} />
    </Fragment>

    <Fragment slot="activity-main">
      {lab.slug === 'pc-assembly' ? (
        <PcAssemblyLab client:only="react" labSlug={lab.slug} />
      ) : lab.data.activity === 'code' ? (
        /* Code labs were previously only possible via a dedicated page that
           hardcoded its slugs, which is why exactly one existed. Routing them
           here makes a code lab authorable from frontmatter: set
           activity: code and add a matching entry to codeExercises. */
        <CodeRunner client:only="react" labSlug={lab.slug} exerciseSlug={lab.slug} />
      ) : (
        <LabFrame slug={lab.slug} src={lab.data.labPath} title={lab.data.title} />
      )}
      <BeaconEmitter
        client:only="react"
        domains={lab.data.domains ?? []}
        contentId={lab.slug}
        apiUrl={apiUrl}
      />
    </Fragment>

    <Fragment slot="activity-secondary">
      <ActivityCard>
        <h3>Lab checks</h3>
        <p>Use Run to execute helper routines, then Check/Submit to validate results.</p>
        <p><strong>Shortcut:</strong> Ctrl+Enter triggers submit/check.</p>
      </ActivityCard>
    </Fragment>
  </WorkspaceLayout>
)}
