---
import { getCollection } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';
import Card from '../../components/Card.astro';
import Section from '../../components/Section.astro';

const [tracks, allLabs] = await Promise.all([getCollection('tracks'), getCollection('labs')]);
const sortedLabs = allLabs
  .filter((lab) => !lab.data.hidden)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<AppShell
  title="Labs"
  tracks={tracks}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Labs' },
  ]}
>
  <section class="hero">
    <h1 class="hero__title">Labs</h1>
    <p class="hero__subtitle">Hands-on labs with step-by-step checks and progress tracking.</p>
  </section>

  <Section title="Available Labs">
    <div class="card-grid">
      {sortedLabs.map((lab) => {
        const minutes = lab.data.estimatedMinutes ?? lab.data.estMinutes ?? 20;
        return (
          <Card title={lab.data.title} className="card--lab">
            <p>{lab.data.description}</p>
            <Fragment slot="meta">
              <span class="badge">{lab.data.difficulty}</span>
              <span class="badge badge--muted">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                {minutes} min
              </span>
              <span class="badge badge--muted">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                {lab.data.xp} XP
              </span>
            </Fragment>
            <Fragment slot="footer">
              <a class="btn-link" href={`/labs/${lab.slug}`}>Open lab →</a>
            </Fragment>
          </Card>
        );
      })}
    </div>
  </Section>
</AppShell>
