---
type CalloutType = 'info' | 'tip' | 'warn' | 'exam';

interface Props {
  type?: CalloutType;
}

const { type = 'info' } = Astro.props as Props;
const labels = {
  info: 'Info',
  tip: 'Tip',
  warn: 'Warning',
  exam: 'Exam Tip',
} as const;
const label = labels[type] ?? 'Note';
---

<div class={`callout callout--${type}`}>
  <div class="callout__title">{label}</div>
  <div class="callout__body">
    <slot />
  </div>
</div>
