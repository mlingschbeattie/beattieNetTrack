---
import ProgressStatus from './islands/ProgressStatus.tsx';

interface Props {
  activePath?: string;
  activeTrackLabel?: string;
}

type NavItem = {
  label: string;
  href: string;
};

const { activePath = '/', activeTrackLabel = 'None' } = Astro.props as Props;

const navItems: NavItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Tour', href: '/tour' },
  { label: 'Learning Tracks', href: '/tracks' },
  { label: 'Study Hub', href: '/quizzes' },
];

const isActive = (href: string) => {
  if (href === '/') return activePath === '/';
  return activePath.startsWith(href);
};
---

<nav class="top-nav">
  <div class="top-nav-inner container">
    <button
      class="sidebar-nav-toggle"
      id="sidebar-nav-toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >☰</button>
    <a href="/" class="brand">
      <div class="brand-icon">BN</div>
      <div class="brand-text">
        <span class="brand-title">BeattieNetTrack</span>
        <span class="brand-subtitle">Build Real Skills. Earn Real Certs.</span>
      </div>
    </a>

    <ul class="nav-links">
      {navItems.map((item) => (
        <li>
          <a
            class={`nav-link${isActive(item.href) ? ' active' : ''}`}
            href={item.href}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="top-nav__actions">
      <div class="nav-session-pill" title="Your currently active certification track">
        <span class="nav-session-dot"></span>
        Active Track: {activeTrackLabel}
      </div>
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Toggle color theme"
        aria-pressed="true"
        title="Toggle theme"
      >
        <span aria-hidden="true" data-theme-icon>🌙</span>
        <span class="sr-only" data-theme-label>Dark</span>
      </button>
      <div class="top-nav__status-slot" data-progress-slot>
        <ProgressStatus client:only="react" />
      </div>
    </div>
  </div>
</nav>
