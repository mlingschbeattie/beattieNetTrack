---


import type { AuthUser } from '../lib/auth';

interface Props {
  activePath?: string;
  activeTrackLabel?: string;
  user?: AuthUser | null;
}

type NavItem = {
  label: string;
  href: string;
};

const { activePath = '/', activeTrackLabel = 'None', user = null } = Astro.props as Props;

const navItems: NavItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Learning Tracks', href: '/tracks' },
  { label: 'Study Hub', href: '/quizzes' },
];

const isActive = (href: string) => {
  if (href === '/') return activePath === '/';
  return activePath.startsWith(href);
};
---

<nav class="top-nav" aria-label="Main navigation">
  <div class="top-nav-inner container">
    <button
      class="sidebar-nav-toggle"
      id="sidebar-nav-toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >☰</button>
    <a href="/" class="brand">
      <div class="brand-icon">BN</div>
      <div class="brand-text">
        <span class="brand-title">BeattieNetTrack</span>
        <span class="brand-subtitle">Build Real Skills. Earn Real Certs.</span>
      </div>
    </a>

    <ul class="nav-links">
      {navItems.map((item) => (
        <li>
          <a
            class={`nav-link${isActive(item.href) ? ' active' : ''}`}
            href={item.href}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="top-nav__actions">
      {user && (
        <div class="nav-user-pill" title={`Logged in as ${user.name} (${user.username})`}>
          <span class="nav-user-avatar" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </span>
          <span class="nav-user-name">{user.name}</span>
        </div>
      )}
      <div class="nav-session-pill" title="Your currently active certification track">
        <span class="nav-session-dot"></span>
        Active Track: {activeTrackLabel}
      </div>
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Toggle color theme"
        aria-pressed="true"
        title="Toggle theme"
      >
        <span aria-hidden="true" data-theme-icon>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </span>
        <span class="sr-only" data-theme-label>Dark</span>
      </button>
    </div>


  </div>
</nav>
