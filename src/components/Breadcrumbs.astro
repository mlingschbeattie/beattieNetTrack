---
type BreadcrumbItem = {
  label: string;
  href?: string;
};

interface Props {
  items?: BreadcrumbItem[];
}

const { items = [] } = Astro.props as Props;
---

{items.length > 0 && (
  <div class="breadcrumb-row">
    <div class="breadcrumb-row__inner container">
      {items.map((item, index) => (
        <div class="breadcrumb">
          {item.href ? (
            <a class="breadcrumb__link" href={item.href}>{item.label}</a>
          ) : (
            <span class="breadcrumb__current">{item.label}</span>
          )}
          {index < items.length - 1 && <span class="breadcrumb__sep">/</span>}
        </div>
      ))}
    </div>
  </div>
)}
