---
import type { CollectionEntry } from 'astro:content';
import SidebarTrackProgress from './islands/SidebarTrackProgress.tsx';
import SidebarTourProgress from './islands/SidebarTourProgress.tsx';

type LessonEntry = CollectionEntry<'lessons'>;
type TrackEntry = CollectionEntry<'tracks'>;

interface Props {
  tracks?: TrackEntry[];
  activeTrack?: string;
  activeLesson?: string;
  currentTrack?: TrackEntry;
  lessonMap?: Record<string, LessonEntry>;
}

const {
  tracks = [],
  activeTrack,
  activeLesson,
  currentTrack,
  lessonMap = {},
} = Astro.props as Props;

const TRACK_ORDER = [
  'tech-plus',
  'pc-technician',
  'network-engineer',
  'cybersecurity-foundations',
  'python-developer',
  'cybersecurity-engineer',
  'web-developer',
  'ai-ml',
  'linux',
  'cyber-literacy',
];

const visibleTracks = (tracks as TrackEntry[])
  .filter((t) => !t.data.hidden)
  .sort((a, b) => {
    const ai = TRACK_ORDER.indexOf(a.slug);
    const bi = TRACK_ORDER.indexOf(b.slug);
    if (ai === -1 && bi === -1) return a.data.title.localeCompare(b.data.title);
    if (ai === -1) return 1;
    if (bi === -1) return -1;
    return ai - bi;
  });

const normalizeItem = (item: string | { type: 'lesson' | 'lab' | 'quiz'; slug: string }) =>
  typeof item === 'string' ? { type: 'lesson' as const, slug: item } : item;

const hrefForItem = (item: { type: 'lesson' | 'lab' | 'quiz'; slug: string }) => {
  if (item.type === 'lesson') return `/lessons/${item.slug}`;
  if (item.type === 'lab') return `/labs/${item.slug}`;
  return `/quizzes/${item.slug}`;
};

const displayTitle = (item: { type: 'lesson' | 'lab' | 'quiz'; slug: string }) => {
  if (item.type === 'lesson') return lessonMap[item.slug]?.data?.title ?? item.slug;
  return item.slug;
};

const trackSections = currentTrack?.data.sections?.map((section) => ({
  title: section.title,
  lessons: section.lessons
    .map((entry) => normalizeItem(entry as string | { type: 'lesson' | 'lab' | 'quiz'; slug: string }))
    .filter((entry) => entry.type === 'lesson')
    .map((entry) => ({
      slug: entry.slug,
      title: lessonMap[entry.slug]?.data?.title ?? entry.slug,
    })),
}));

const sidebarSections = currentTrack?.data.sections?.map((section) => ({
  title: section.title,
  items: section.lessons.map((entry) => normalizeItem(entry as string | { type: 'lesson' | 'lab' | 'quiz'; slug: string })),
}));
const TRACK_SVGS: Record<string, string> = {
  'tech-plus': '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>',
  'pc-technician': '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
  'network-engineer': '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>',
  'cybersecurity-foundations': '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
  'python-developer': '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
  'cybersecurity-engineer': '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>',
  'web-developer': '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
  'ai-ml': '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>',
  'linux': '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>',
  'cyber-literacy': '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>'
};
const DEFAULT_TRACK_SVG = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/></svg>';
---

<aside class="sidebar" id="app-sidebar">
  <div class="sidebar__brand">
    <span class="sidebar__brand-badge">BN</span>
    <span class="sidebar__brand-text">Beattie Tech</span>
  </div>

  <div class="sidebar__section">
    <div class="sidebar__title">Learning Tracks</div>
    {visibleTracks.map((track) => {
      const svg = TRACK_SVGS[track.slug] || DEFAULT_TRACK_SVG;
      return (
        <a
          class={`sidebar__link ${activeTrack === track.slug ? 'sidebar__link--active' : ''}`}
          href={`/tracks/${track.slug}`}
        >
          <span class="sidebar__link-icon" set:html={svg}></span>
          <span class="sidebar__link-text">{track.data.title}</span>
        </a>
      );
    })}
  </div>

  {currentTrack && currentTrack.data.sections?.length > 0 && (
    <div class="sidebar__section">
      <div class="sidebar__title">Lessons</div>
      <div class="sidebar__progress-slot" data-sidebar-progress-slot>
        <div class="sidebar__skeleton">
          {sidebarSections?.map((section) => (
            <div class="sidebar__group">
              <div class="sidebar__group-title">{section.title}</div>
              {section.items.map((item) => (
                <a
                  class={`sidebar__lesson-link ${activeLesson === item.slug ? 'sidebar__lesson-link--active' : ''}`}
                  href={hrefForItem(item)}
                >
                  <span class="sidebar__lesson-title">{displayTitle(item)}</span>
                </a>
              ))}
            </div>
          ))}
        </div>
        {trackSections && (
          <div class="sidebar__react">
            <SidebarTrackProgress
              client:only="react"
              sections={trackSections}
              activeLesson={activeLesson}
            />
          </div>
        )}
      </div>
    </div>
  )}

  <div class="sidebar__section">
    <div class="sidebar__title">Navigation</div>
    <a class="sidebar__link" href="/">
      <span class="sidebar__link-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span>
      <span>Dashboard</span>
    </a>
    <a class="sidebar__link" href="/tour">
      <span class="sidebar__link-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg></span>
      <span>Interactive Tour</span>
    </a>
    <div class="sidebar__react">
      <SidebarTourProgress client:load />
    </div>
  </div>
</aside>
