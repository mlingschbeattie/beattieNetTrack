---
import '../styles/global.css';
// Opt-in legacy compatibility styles. These are scoped under `html[data-skin="legacy"]`.
// To enable legacy primitives on a page add `data-skin="legacy"` to the top-level HTML element.
import '../styles/legacy-compat.css';

// `legacySkin` is an opt-in flag (boolean). When true it sets `data-skin="legacy"`
// on the top-level `<html>` element so legacy-compat styles (scoped) apply only
// to that page. Keep this limited to single-page visual testing; do not enable
// site-wide or persist across sessions.
import { LANGUAGES, allDictionaries } from '../i18n';

const { title = 'Beattie Tech', legacySkin = false } = Astro.props;

// Every dictionary ships once so switching language is instant and offline-safe
// (no round trip), matching the local-first model the rest of the app uses.
const dictionaries = allDictionaries();
const rtlLangs = LANGUAGES.filter((l) => l.dir === 'rtl').map((l) => l.code);
---

<!doctype html>
<html lang="en" data-skin={legacySkin ? 'legacy' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <script type="application/json" id="bn-rtl-langs" is:inline set:html={JSON.stringify(rtlLangs)}></script>
    <script type="application/json" id="bn-i18n" is:inline set:html={JSON.stringify(dictionaries)}></script>
    <script is:inline>
      (() => {
        try {
          // Explicit choice wins; otherwise follow the OS preference so the
          // app matches the rest of the user's environment on first visit.
          const stored = window.localStorage.getItem('theme');
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;

          // Accessibility prefs applied before first paint so a student who
          // needs calm mode or larger text never sees the unstyled version.
          const a11y = JSON.parse(window.localStorage.getItem('beattie_a11y_v1') || '{}');
          const root = document.documentElement;
          root.dataset.motion = a11y.motion || 'system';
          root.dataset.calm = a11y.calmMode ? 'on' : 'off';
          root.dataset.textSize = a11y.textSize || 'default';
          root.dataset.spacing = a11y.readableSpacing ? 'readable' : 'default';
          root.dataset.underlineLinks = a11y.underlineLinks ? 'on' : 'off';

          document.documentElement.lang = 'en';
          document.documentElement.dir = 'ltr';
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- Language selector now lives in the top nav (see Navbar.astro). -->

    <script>
      document.documentElement.classList.add('js');
      
      const readJson = (id: string, fallback: any) => {
        try {
          const el = document.getElementById(id);
          return el ? JSON.parse(el.textContent || '') : fallback;
        } catch {
          return fallback;
        }
      };
      const DICTS = readJson('bn-i18n', {});

      /**
       * Applies the active dictionary to every marked node. Elements opt in
       * with data-i18n (text), data-i18n-aria-label, data-i18n-title, or
       * data-i18n-placeholder. Anything unmarked keeps its authored English —
       * which is correct for lesson/quiz CONTENT, deliberately untranslated.
       */
      const applyTranslations = (lang: string) => {
        const dict = DICTS[lang] || DICTS.en || {};
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (key && dict[key]) el.textContent = dict[key];
        });
        const attrMap: Array<[string, string]> = [
          ['data-i18n-aria-label', 'aria-label'],
          ['data-i18n-title', 'title'],
          ['data-i18n-placeholder', 'placeholder'],
        ];
        attrMap.forEach(([dataAttr, realAttr]) => {
          document.querySelectorAll('[' + dataAttr + ']').forEach((el) => {
            const key = el.getAttribute(dataAttr);
            if (key && dict[key]) el.setAttribute(realAttr, dict[key]);
          });
        });
      };

      const updateLangUi = (_currentLang?: string) => {
        document.documentElement.lang = 'en';
        document.documentElement.dir = 'ltr';
        localStorage.setItem('beattienet_lang', 'en');
        applyTranslations('en');
        window.dispatchEvent(new CustomEvent('beattie:langchange', { detail: { lang: 'en' } }));
      };

      updateLangUi('en');
      const themeToggle = document.querySelector('[data-theme-toggle]');
      const themeIcon = document.querySelector('[data-theme-icon]');
      const themeLabel = document.querySelector('[data-theme-label]');

      const applyThemeUi = (theme: 'light' | 'dark') => {
        const isLight = theme === 'light';
        document.documentElement.setAttribute('data-theme', theme);
        // Keeps form controls, scrollbars and caret in step with the palette.
        document.documentElement.style.colorScheme = theme;
        if (themeIcon) themeIcon.textContent = isLight ? '☀️' : '🌙';
        if (themeLabel) themeLabel.textContent = isLight ? 'Light' : 'Dark';
        if (themeToggle instanceof HTMLButtonElement) {
          themeToggle.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
        }
      };

      const currentTheme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      applyThemeUi(currentTheme);

      themeToggle?.addEventListener('click', () => {
        const nextTheme = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        window.localStorage.setItem('theme', nextTheme);
        applyThemeUi(nextTheme);
      });

      const toggleButton = document.querySelector('[data-sidebar-toggle]');
      const overlay = document.querySelector('[data-sidebar-close]');

      const closeSidebar = () => document.body.classList.remove('sidebar-open');

      toggleButton?.addEventListener('click', () => {
        document.body.classList.toggle('sidebar-open');
      });

      overlay?.addEventListener('click', closeSidebar);

      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeSidebar();
        }
      });

      const markReady = (selector: string, className: string) => {
        if (document.querySelector(selector)) {
          document.documentElement.classList.add(className);
          return;
        }
        const observer = new MutationObserver(() => {
          if (!document.querySelector(selector)) return;
          document.documentElement.classList.add(className);
          observer.disconnect();
        });
        observer.observe(document.body, { childList: true, subtree: true });
        window.setTimeout(() => observer.disconnect(), 4000);
      };

      markReady('[data-testid="status-level"]', 'progress-ready');
      markReady('.sidebar-progress', 'sidebar-ready');
    </script>
  </body>
</html>
