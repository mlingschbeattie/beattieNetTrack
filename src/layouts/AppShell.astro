---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Navbar from '../components/Navbar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RightPanel from '../components/islands/RightPanel.tsx';
import SearchOverlay from '../components/SearchOverlay.astro';
import { getModuleProgressData } from '../lib/content';
import { getSearchIndexData } from '../lib/searchIndex';

const {
  title,
  tracks = [],
  activeTrack,
  activeLesson,
  currentTrack,
  breadcrumbs = [],
  lessonMap = {},
  showRightPanel = false,
  rightPanelHints = [],
  rightPanelChecklist = [],
  activityNavigation,
} = Astro.props;
// Allow a page to opt-in to legacy skin by passing `legacySkin` prop (boolean).
// This is intentionally small-scope and should only be used for visual testing.
const { legacySkin = false } = Astro.props;
const activePath = Astro.url.pathname;
const searchIndexData = await getSearchIndexData();
const searchIndexJson = JSON.stringify(searchIndexData);
let moduleProgress = null;
if (activityNavigation && (activityNavigation as any).trackSlug && (activityNavigation as any).moduleSlug) {
  try {
    moduleProgress = await getModuleProgressData((activityNavigation as any).trackSlug, (activityNavigation as any).moduleSlug);
  } catch {
    moduleProgress = null;
  }
}
---

<BaseLayout title={title} legacySkin={legacySkin}>
  <div class="binary-bg" id="binary-bg" aria-hidden="true"></div>
  <script id="__SEARCH_INDEX__" type="application/json" is:inline set:html={searchIndexJson}></script>
  <Navbar activePath={activePath} />
  <Breadcrumbs items={breadcrumbs} />
  <div class="app-shell">
    <Sidebar
      tracks={tracks}
      activeTrack={activeTrack}
      activeLesson={activeLesson}
      currentTrack={currentTrack}
      lessonMap={lessonMap}
    />
    <div class="sidebar-overlay" id="sidebar-backdrop" data-sidebar-close></div>
    <main class="content-pane">
      <div class={`content-wrap container ${showRightPanel ? 'container--workspace' : ''}`}>
        <button class="sidebar-toggle" type="button" data-sidebar-toggle>
          ☰ Menu
        </button>
        <div class={`content-stage ${showRightPanel ? 'content-stage--with-panel' : ''}`}>
          <div class="content-main">
            {moduleProgress ? (
              <div style="margin-bottom:8px">
                <span
                  class="pill pill--muted"

 
                  data-module-progress
                  data-total={String(moduleProgress.total)}
                  data-completed={String(moduleProgress.completed)}
                  data-activities={JSON.stringify(moduleProgress.activities)}
                >
                  Module Progress: <span class="mp-completed">0</span> / <span class="mp-total">{String(moduleProgress.total)}</span> (<span class="mp-percent">0%</span>)
                </span>
              </div>
            ) : null}
            <slot />
            {activityNavigation && (activityNavigation.prev || activityNavigation.next) && (
              <nav class="card" aria-label="Module activity navigation" data-testid="activity-prev-next-nav">
                <h3>Continue Module</h3>
                <div class="card__footer">
                  {activityNavigation.prev && (
                    <p>
                      <a class="btn-link" href={activityNavigation.prev.href} data-testid="activity-prev-link">
                        ← Previous: {activityNavigation.prev.title}
                      </a>
                    </p>
                  )}
                  {activityNavigation.next && (
                    <p>
                      <a class="btn-link" href={activityNavigation.next.href} data-testid="activity-next-link">
                        Next: {activityNavigation.next.title} →
                      </a>
                    </p>
                  )}
                </div>
              </nav>
            )}
          </div>
          {showRightPanel && (
            <RightPanel
              routePath={activePath}
              hints={rightPanelHints}
              checklist={rightPanelChecklist}
              client:only="react"
            />
          )}
        </div>
      </div>
    </main>
  </div>
  <SearchOverlay />
</BaseLayout>

<script>
  // Global search overlay controller
  try {
    const overlay = document.getElementById('global-search-overlay');
    const input = document.getElementById('global-search-input') as HTMLInputElement | null;
    const results = document.getElementById('global-search-results');
    const raw = document.getElementById('__SEARCH_INDEX__')?.textContent ?? '[]';
    type SearchResultItem = {
      type: 'track' | 'lesson' | 'lab' | 'quiz';
      title: string;
      description: string;
      slug: string;
      href: string;
    };

    const parsed: unknown = JSON.parse(raw);
    const index: SearchResultItem[] = Array.isArray(parsed)
      ? (parsed as SearchResultItem[])
      : [];

    let flatLinks: HTMLAnchorElement[] = [];
    let activeIndex = -1;

    const groupLabel = (type: SearchResultItem['type']) => {
      if (type === 'track') return 'Tracks & Modules';
      if (type === 'lesson') return 'Lessons';
      if (type === 'lab') return 'Labs';
      return 'Quizzes';
    };

    const closeOverlay = () => {
      if (!overlay) return;
      overlay.setAttribute('hidden', '');
      if (input) input.value = '';
      if (results) results.innerHTML = '';
      activeIndex = -1;
    };

    const updateActiveLink = () => {
      flatLinks.forEach((link, idx) => {
        link.classList.toggle('is-active', idx === activeIndex);
      });
    };

    const renderResults = (query: string) => {
      if (!results) return;
      const q = query.trim().toLowerCase();
      if (!q) {
        results.innerHTML = '<p class="search-overlay__empty">Type to search all content.</p>';
        flatLinks = [];
        activeIndex = -1;
        return;
      }

      const filtered = index
        .filter((item: SearchResultItem) => {
          const title = (item.title ?? '').toLowerCase();
          const description = (item.description ?? '').toLowerCase();
          return title.includes(q) || description.includes(q);
        })
        .slice(0, 8);

      if (!filtered.length) {
        results.innerHTML = '<p class="search-overlay__empty">No matches found.</p>';
        flatLinks = [];
        activeIndex = -1;
        return;
      }

      const grouped = filtered.reduce<Record<SearchResultItem['type'], SearchResultItem[]>>((acc, item) => {
        if (!acc[item.type]) acc[item.type] = [];
        acc[item.type].push(item);
        return acc;
      }, { track: [], lesson: [], lab: [], quiz: [] });

      const typeOrder: SearchResultItem['type'][] = ['track', 'lesson', 'lab', 'quiz'];
      const parts = [];
      for (const type of typeOrder) {
        const entries = grouped[type];
        if (!entries || !entries.length) continue;
        parts.push(`<p class="search-overlay__group">${groupLabel(type)}</p>`);
        parts.push('<ul class="search-overlay__list">');
        for (const item of entries) {
          parts.push(
            `<li class="search-overlay__item"><a class="search-overlay__link" href="${item.href}" data-search-result-link><span class="search-overlay__title">${item.title}</span><span class="search-overlay__meta">${item.slug}</span></a></li>`
          );
        }
        parts.push('</ul>');
      }

      results.innerHTML = parts.join('');
      flatLinks = Array.from(results.querySelectorAll('[data-search-result-link]')) as HTMLAnchorElement[];
      activeIndex = flatLinks.length ? 0 : -1;
      updateActiveLink();
    };

    const openOverlay = () => {
      if (!overlay) return;
      overlay.removeAttribute('hidden');
      renderResults('');
      if (input instanceof HTMLInputElement) {
        window.setTimeout(() => input.focus(), 0);
      }
    };

    document.addEventListener('keydown', (event) => {
      const key = event.key.toLowerCase();
      if ((event.metaKey || event.ctrlKey) && key === 'k') {
        event.preventDefault();
        openOverlay();
        return;
      }
      if (key === 'escape' && overlay && !overlay.hasAttribute('hidden')) {
        event.preventDefault();
        closeOverlay();
      }
    });

    if (input instanceof HTMLInputElement) {
      input.addEventListener('input', () => renderResults(input.value));
      input.addEventListener('keydown', (event) => {
        if (!flatLinks.length) return;
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          activeIndex = Math.min(flatLinks.length - 1, activeIndex + 1);
          updateActiveLink();
          return;
        }
        if (event.key === 'ArrowUp') {
          event.preventDefault();
          activeIndex = Math.max(0, activeIndex - 1);
          updateActiveLink();
          return;
        }
        if (event.key === 'Enter' && activeIndex >= 0) {
          event.preventDefault();
          const href = flatLinks[activeIndex]?.getAttribute('href');
          if (href) window.location.assign(href);
        }
      });
    }

    if (overlay) {
      overlay.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        if (target.closest('[data-search-close]')) {
          closeOverlay();
        }
      });
    }

    document.documentElement.setAttribute('data-search-ready', 'true');
  } catch {}
</script>

<script>
  // Client updater for module progress badges rendered in AppShell
  try {
    const updateModuleProgressAppShell = () => {
      const mpEls = Array.from(document.querySelectorAll('[data-module-progress]')) as HTMLElement[];
      if (!mpEls.length) return;
      let raw = null;
      try {
        raw = JSON.parse(window.localStorage.getItem('beattie_progress_v1') ?? 'null');
      } catch {
        raw = null;
      }
      for (const el of mpEls) {
        const activitiesAttr = el.getAttribute('data-activities') ?? '[]';
        let activities = [] as Array<{ type: string; slug: string }>;
        try {
          activities = JSON.parse(activitiesAttr);
        } catch {
          activities = [];
        }
        let completed = 0;
        if (raw && typeof raw === 'object') {
          for (const act of activities) {
            const key = act.type === 'lab' ? 'labs' : act.type === 'quiz' ? 'quizzes' : 'lessons';
            if (raw[key] && raw[key][act.slug] && raw[key][act.slug].completed) completed += 1;
          }
        }
        const total = Number(el.getAttribute('data-total') ?? 0) || activities.length;
        const percent = total > 0 ? Math.round((completed / total) * 100) : 0;
        const completedEl = el.querySelector('.mp-completed');
        const percentEl = el.querySelector('.mp-percent');
        if (completedEl) completedEl.textContent = String(completed);
        if (percentEl) percentEl.textContent = `${percent}%`;
      }
    };
    updateModuleProgressAppShell();
    window.addEventListener('progress-updated', updateModuleProgressAppShell);
  } catch {}
</script>

<script>
  const bg = document.getElementById('binary-bg');
  if (bg) {
    for (let i = 0; i < 32; i++) {
      const col = document.createElement('div');
      col.className = 'binary-column';
      col.style.left = `${(i / 32) * 100}%`;
      const dur = 10 + Math.random() * 10;
      col.style.animationDuration = `${dur}s`;
      col.style.animationDelay = `${-Math.random() * dur}s`;
      col.textContent = Array.from({ length: 26 }, () =>
        Math.random() > 0.5 ? '1' : '0'
      ).join('\n');
      bg.appendChild(col);
    }
  }
</script>

<script>
  // Nav hamburger toggle — syncs with existing body.sidebar-open system
  try {
    const navToggle = document.getElementById('sidebar-nav-toggle') as HTMLButtonElement | null;
    const backdrop = document.getElementById('sidebar-backdrop');

    const openSidebar = () => {
      document.body.classList.add('sidebar-open');
      navToggle?.setAttribute('aria-expanded', 'true');
      if (navToggle) navToggle.textContent = '✕';
    };
    const closeSidebarNav = () => {
      document.body.classList.remove('sidebar-open');
      navToggle?.setAttribute('aria-expanded', 'false');
      if (navToggle) navToggle.textContent = '\u2630';
    };

    navToggle?.addEventListener('click', () => {
      document.body.classList.contains('sidebar-open') ? closeSidebarNav() : openSidebar();
    });

    // Keep icon in sync when backdrop or content toggle closes the sidebar
    backdrop?.addEventListener('click', closeSidebarNav);
    document.querySelector('[data-sidebar-toggle]')?.addEventListener('click', () => {
      const isOpen = document.body.classList.contains('sidebar-open');
      navToggle?.setAttribute('aria-expanded', String(isOpen));
      if (navToggle) navToggle.textContent = isOpen ? '✕' : '\u2630';
    });
  } catch {}
</script>
